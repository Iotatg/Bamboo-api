# Bamboo-api configuration.
#
# Bun loads .env automatically. Every value here is optional: the gateway
# starts on the defaults below.

NODE_ENV=development
HOST=0.0.0.0
PORT=8787

# Where the JSON database lives.
DATA_FILE=data/bamboo.json

# Public identity, used in the console and in the curl snippets.
SITE_NAME=Bamboo-api
SITE_URL=http://localhost:8787

# The upstream. This is the APInex gateway that actually serves the models.
UPSTREAM_BASE_URL=https://api.apinex.bond/v1
UPSTREAM_API_KEY=sk-apx-replace-me
UPSTREAM_TIMEOUT=180

# The admin account, created on first start.
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=change-this-password

# Billing and limits.
DEFAULT_RPM=60
FREE_MONTHLY_TOKENS=100000
SESSION_DAYS=7
CONTACT_EMAIL=support@example.com
