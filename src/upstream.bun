// src/upstream.bun — the only place that talks to APInex.
//
// Two paths:
//   post_json    one request, one answer (http_post does the TLS for us)
//   post_stream  the answer arrives as SSE; we read the socket ourselves so
//                each event can be forwarded the moment it lands

import { CONFIG } from "./config.bun"
import { store_data, store_save, store_mutate, store_all, store_find, store_where, store_by_id, store_insert, store_remove, store_setting, store_set_setting, store_trim_usage } from "./store.bun"

export fn upstream_split_url(url) {
    var rest = url
    var scheme = "https"
    if rest.starts_with("https://") {
        rest = rest.slice(8, len(rest))
    } else if rest.starts_with("http://") {
        scheme = "http"
        rest = rest.slice(7, len(rest))
    }
    let slash = rest.index_of("/")
    var host_part = rest
    var base = "/"
    if slash >= 0 {
        host_part = rest.slice(0, slash)
        base = rest.slice(slash, len(rest))
    }
    var host = host_part
    var port = 443
    if scheme == "http" {
        port = 80
    }
    let colon = host_part.index_of(":")
    if colon > 0 {
        host = host_part.slice(0, colon)
        port = int(host_part.slice(colon + 1, len(host_part)))
    }
    return { "scheme": scheme, "host": host, "port": port, "base": base }
}

fn auth_headers(extra) {
    let headers = {
        "Content-Type": "application/json",
        "Accept": "application/json",
        "User-Agent": "Bamboo-api/0.1"
    }
    var key = CONFIG["upstream_api_key"]
    let stored = store_setting("upstream_key", "")
    if stored != null and str(stored) != "" {
        key = str(stored)
    }
    if key != "" {
        headers["Authorization"] = "Bearer " + key
    }
    if extra != null {
        for name in extra.keys() {
            headers[name] = extra.get(name)
        }
    }
    return headers
}

export fn upstream_url_for(path) {
    return CONFIG["upstream_base_url"] + path
}

// One request, one answer.
export fn upstream_post_json(path, payload, extra_headers) {
    let body = json_stringify(payload)
    let headers = auth_headers(extra_headers)
    let timeout = CONFIG["upstream_timeout"]
    try {
        let result = http_post(upstream_url_for(path), headers, body, timeout)
        return { "ok": true, "status": result["status"], "body": result["body"] }
    } catch err {
        return { "ok": false, "status": 502, "body": str(err) }
    }
}

export fn upstream_get_json(path, extra_headers) {
    let headers = auth_headers(extra_headers)
    let timeout = CONFIG["upstream_timeout"]
    try {
        let result = http_get(upstream_url_for(path), headers, timeout)
        return { "ok": true, "status": result["status"], "body": result["body"] }
    } catch err {
        return { "ok": false, "status": 502, "body": str(err) }
    }
}

// ---------------------------------------------------------------------------
// The streaming path
// ---------------------------------------------------------------------------

fn index_of_byte(hay, byte, start_at) {
    var i = start_at
    while i < len(hay) {
        if hay[i] == byte {
            return i
        }
        i = i + 1
    }
    return -1
}

fn read_head(conn) {
    let marker = utf8_bytes("\r\n\r\n")
    var buffer = []
    while true {
        let chunk = tcp_read(conn, 8192)
        if len(chunk) == 0 {
            return null
        }
        for byte in chunk {
            buffer.push(byte)
        }
        let mark = index_of_bytes(buffer, marker)
        if mark >= 0 {
            let head = utf8_string(buffer.slice(0, mark))
            var rest = []
            var i = mark + 4
            while i < len(buffer) {
                rest.push(buffer[i])
                i = i + 1
            }
            return { "head": head, "rest": rest }
        }
        if len(buffer) > 65536 {
            return null
        }
    }
}

fn index_of_bytes(hay, needle) {
    let limit = len(hay) - len(needle)
    var i = 0
    while i <= limit {
        var same = true
        var j = 0
        while j < len(needle) {
            if hay[i + j] != needle[j] {
                same = false
                j = len(needle)
            } else {
                j = j + 1
            }
        }
        if same {
            return i
        }
        i = i + 1
    }
    return -1
}

fn parse_status(head) {
    let line = head.split("\r\n")[0]
    let parts = line.split(" ")
    if len(parts) < 2 {
        return 0
    }
    return int(parts[1])
}

fn header_of(head, name) {
    let wanted = name.lower()
    for line in head.split("\r\n") {
        let colon = line.index_of(":")
        if colon > 0 {
            if line.slice(0, colon).trim().lower() == wanted {
                return line.slice(colon + 1, len(line)).trim()
            }
        }
    }
    return null
}

fn emit_lines(buffer, flush, on_line) {
    var keep = []
    var start = 0
    var i = 0
    while i < len(buffer) {
        if buffer[i] == 10 {
            var line = utf8_string(buffer.slice(start, i))
            if line.ends_with("\r") {
                line = line.slice(0, len(line) - 1)
            }
            on_line(line)
            start = i + 1
        }
        i = i + 1
    }
    i = start
    while i < len(buffer) {
        keep.push(buffer[i])
        i = i + 1
    }
    if flush and len(keep) > 0 {
        on_line(utf8_string(keep))
        return []
    }
    return keep
}

// Open a POST that asked for `stream: true` and read the response head.
//
// The head is read here, not by the caller, so a 4xx from the upstream can
// still be answered as a normal JSON error instead of an SSE stream that
// starts with a failure.
export fn upstream_open_stream(path, payload, extra_headers) {
    let parts = upstream_split_url(upstream_url_for(path))
    let host = parts["host"]
    let port = parts["port"]
    let target = parts["base"]
    let body = json_stringify(payload)
    let body_bytes = utf8_bytes(body)
    let headers = auth_headers(extra_headers)
    headers["Accept"] = "text/event-stream"
    headers["Host"] = host
    headers["Connection"] = "close"
    headers["Content-Length"] = str(len(body_bytes))

    var head_text = "POST " + target + " HTTP/1.1\r\n"
    for name in headers.keys() {
        head_text = head_text + name + ": " + str(headers.get(name)) + "\r\n"
    }
    head_text = head_text + "\r\n"

    var conn = null
    try {
        if parts["scheme"] == "https" {
            conn = tcp_tls_connect(host, port, ["http/1.1"], host)
        } else {
            conn = tcp_connect(host, port)
        }
    } catch err {
        return { "ok": false, "status": 502, "error": "upstream connect failed: " + str(err) }
    }

    var frame = utf8_bytes(head_text)
    for byte in body_bytes {
        frame.push(byte)
    }
    try {
        tcp_write(conn, frame)
    } catch err {
        safe_close(conn)
        return { "ok": false, "status": 502, "error": "upstream write failed: " + str(err) }
    }

    let head_result = read_head(conn)
    if head_result == null {
        safe_close(conn)
        return { "ok": false, "status": 502, "error": "upstream sent no headers" }
    }
    let status = parse_status(head_result["head"])
    if status < 200 or status >= 300 {
        var text = ""
        var pending = head_result["rest"]
        if len(pending) > 0 {
            text = utf8_string(pending)
        }
        var guard = 0
        while guard < 32 {
            guard = guard + 1
            var chunk = []
            try {
                chunk = tcp_read(conn, 8192)
            } catch err {
                chunk = []
            }
            if len(chunk) == 0 {
                guard = 32
            } else {
                text = text + utf8_string(chunk)
            }
        }
        safe_close(conn)
        return { "ok": false, "status": status, "error": text }
    }

    let encoding = header_of(head_result["head"], "transfer-encoding")
    var chunked = false
    if encoding != null and encoding.lower().contains("chunked") {
        chunked = true
    }
    return {
        "ok": true,
        "status": status,
        "conn": conn,
        "rest": head_result["rest"],
        "chunked": chunked
    }
}

// Read an open stream to its end, calling `on_line` for every SSE line.
export fn upstream_pump(handle, on_line) {
    var buffer = handle["rest"]
    var done = false
    while !done {
        if handle["chunked"] {
            let outcome = drain_chunks(handle["conn"], buffer, on_line)
            buffer = outcome["rest"]
            done = outcome["done"]
        } else {
            var chunk = []
            try {
                chunk = tcp_read(handle["conn"], 8192)
            } catch err {
                chunk = []
            }
            if len(chunk) == 0 {
                emit_lines(buffer, true, on_line)
                done = true
            } else {
                for byte in chunk {
                    buffer.push(byte)
                }
                buffer = emit_lines(buffer, false, on_line)
            }
        }
    }
    safe_close(handle["conn"])
    return { "ok": true }
}

fn safe_close(conn) {
    try {
        tcp_close(conn)
    } catch err {
        print("[upstream] close failed: " + str(err))
    }
    return null
}

// The whole stream in one call, for callers that do not need the head first.
export fn upstream_post_stream(path, payload, extra_headers, on_line) {
    let handle = upstream_open_stream(path, payload, extra_headers)
    if !handle["ok"] {
        return handle
    }
    upstream_pump(handle, on_line)
    return { "ok": true, "status": handle["status"] }
}

// Decode the chunked encoding, emitting the lines of every chunk.
fn drain_chunks(conn, buffer, on_line) {
    while true {
        let line_end = index_of_byte(buffer, 10, 0)
        if line_end < 0 {
            let chunk = read_more(conn)
            if len(chunk) == 0 {
                return { "rest": buffer, "done": true }
            }
            for byte in chunk {
                buffer.push(byte)
            }
        } else {
            var size_text = utf8_string(buffer.slice(0, line_end)).trim()
            let semi = size_text.index_of(";")
            if semi >= 0 {
                size_text = size_text.slice(0, semi)
            }
            let size = hex_to_int(size_text)
            if size <= 0 {
                return { "rest": [], "done": true }
            }
            while len(buffer) < line_end + 1 + size + 2 {
                let chunk = read_more(conn)
                if len(chunk) == 0 {
                    return { "rest": [], "done": true }
                }
                for byte in chunk {
                    buffer.push(byte)
                }
            }
            let payload = buffer.slice(line_end + 1, line_end + 1 + size)
            emit_lines(payload, true, on_line)
            var rest = []
            var i = line_end + 1 + size + 2
            while i < len(buffer) {
                rest.push(buffer[i])
                i = i + 1
            }
            buffer = rest
        }
    }
}

fn read_more(conn) {
    try {
        return tcp_read(conn, 8192)
    } catch err {
        return []
    }
}

fn hex_to_int(text) {
    var value = 0
    var i = 0
    while i < len(text) {
        let digit = "0123456789abcdef".index_of(text.slice(i, i + 1).lower())
        if digit >= 0 {
            value = value * 16 + digit
        }
        i = i + 1
    }
    return value
}
