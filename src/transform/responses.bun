// src/transform/responses.bun — the OpenAI Responses API, translated onto
// chat completions.
//
// The upstream exposes chat completions. A Responses client sends `input`
// instead of `messages` and expects `output` items instead of `choices`,
// so both directions are mapped here.

import { crypto_hex_of, crypto_random_hex, crypto_uuid, crypto_new_api_key, crypto_hash_key, crypto_key_prefix, crypto_hash_password, crypto_verify_password, crypto_hex_to_bytes, crypto_same_secret, crypto_token } from "../crypto.bun"

fn item_text(content) {
    if content == null {
        return ""
    }
    if type_of(content) == "string" {
        return content
    }
    var out = ""
    if type_of(content) == "list" {
        for part in content {
            if type_of(part) == "dict" {
                if part.has("text") {
                    out = out + str(part["text"])
                } else if part.has("content") {
                    out = out + item_text(part["content"])
                }
            } else {
                out = out + str(part)
            }
        }
    }
    return out
}

fn input_to_messages(input) {
    let out = []
    if input == null {
        return out
    }
    if type_of(input) == "string" {
        out.push({ "role": "user", "content": input })
        return out
    }
    for item in input {
        if type_of(item) != "dict" {
            out.push({ "role": "user", "content": str(item) })
            continue
        }
        var role = "user"
        if item.has("role") {
            role = str(item["role"])
        }
        if item.has("type") and item["type"] == "function_call_output" {
            out.push({
                "role": "tool",
                "tool_call_id": str(item["call_id"]),
                "content": item_text(item["output"])
            })
        } else {
            out.push({ "role": role, "content": item_text(item["content"]) })
        }
    }
    return out
}

fn tools_to_chat(tools) {
    if tools == null {
        return null
    }
    let out = []
    for tool in tools {
        if type_of(tool) != "dict" {
            continue
        }
        var kind = "function"
        if tool.has("type") {
            kind = str(tool["type"])
        }
        if kind != "function" {
            continue
        }
        var parameters = {}
        if tool.has("parameters") {
            parameters = tool["parameters"]
        }
        out.push({
            "type": "function",
            "function": {
                "name": str(tool["name"]),
                "description": str(tool["description"]),
                "parameters": parameters
            }
        })
    }
    if len(out) == 0 {
        return null
    }
    return out
}

export fn responses_to_chat_request(body, upstream_model) {
    let messages = []
    if body.has("instructions") {
        let instructions = item_text(body["instructions"])
        if instructions != "" {
            messages.push({ "role": "system", "content": instructions })
        }
    }
    for message in input_to_messages(body["input"]) {
        messages.push(message)
    }
    let payload = { "model": upstream_model, "messages": messages, "stream": false }
    if body.has("stream") {
        payload["stream"] = body["stream"]
    }
    if body.has("max_output_tokens") {
        payload["max_tokens"] = body["max_output_tokens"]
    }
    if body.has("temperature") {
        payload["temperature"] = body["temperature"]
    }
    if body.has("top_p") {
        payload["top_p"] = body["top_p"]
    }
    if body.has("tools") {
        let tools = tools_to_chat(body["tools"])
        if tools != null {
            payload["tools"] = tools
        }
    }
    if payload["stream"] == true {
        payload["stream_options"] = { "include_usage": true }
    }
    return payload
}

export fn responses_from_chat_response(data, model) {
    var text = ""
    var finish = "stop"
    if data.has("choices") and len(data["choices"]) > 0 {
        let choice = data["choices"][0]
        if choice.has("message") and choice["message"].has("content") {
            if choice["message"]["content"] != null {
                text = str(choice["message"]["content"])
            }
        }
        if choice.has("finish_reason") and choice["finish_reason"] != null {
            finish = str(choice["finish_reason"])
        }
    }
    var input_tokens = 0
    var output_tokens = 0
    if data.has("usage") {
        if data["usage"].has("prompt_tokens") {
            input_tokens = data["usage"]["prompt_tokens"]
        }
        if data["usage"].has("completion_tokens") {
            output_tokens = data["usage"]["completion_tokens"]
        }
    }
    let item_id = "msg_" + crypto_random_hex(10)
    return {
        "id": "resp_" + crypto_random_hex(12),
        "object": "response",
        "created_at": int(now()),
        "status": "completed",
        "model": model,
        "output": [
            {
                "type": "message",
                "id": item_id,
                "status": "completed",
                "role": "assistant",
                "content": [
                    { "type": "output_text", "text": text, "annotations": [] }
                ]
            }
        ],
        "parallel_tool_calls": false,
        "usage": {
            "input_tokens": input_tokens,
            "output_tokens": output_tokens,
            "total_tokens": input_tokens + output_tokens
        },
        "incomplete_details": null,
        "error": null
    }
}

// A stream mapper for the Responses event names.
export fn responses_stream_mapper(model, prompt_tokens) {
    let response_id = "resp_" + crypto_random_hex(12)
    let item_id = "msg_" + crypto_random_hex(10)
    var started = false
    var text_open = false
    var text = ""
    var output_tokens = 0
    var input_tokens = prompt_tokens

    let emit = fn (name, payload) {
        return "event: " + name + "\n" + "data: " + json_stringify(payload) + "\n\n"
    }

    let start = fn () {
        started = true
        return emit("response.created", {
            "type": "response.created",
            "response": {
                "id": response_id,
                "object": "response",
                "created_at": int(now()),
                "status": "in_progress",
                "model": model,
                "output": []
            }
        }) + emit("response.output_item.added", {
            "type": "response.output_item.added",
            "output_index": 0,
            "item": {
                "type": "message",
                "id": item_id,
                "status": "in_progress",
                "role": "assistant",
                "content": []
            }
        }) + emit("response.content_part.added", {
            "type": "response.content_part.added",
            "item_id": item_id,
            "output_index": 0,
            "content_index": 0,
            "part": { "type": "output_text", "text": "", "annotations": [] }
        })
    }

    let feed = fn (chunk) {
        var out = ""
        if !started {
            out = out + start()
        }
        if chunk.has("usage") and chunk["usage"] != null {
            if chunk["usage"].has("completion_tokens") {
                output_tokens = chunk["usage"]["completion_tokens"]
            }
            if chunk["usage"].has("prompt_tokens") and chunk["usage"]["prompt_tokens"] > 0 {
                input_tokens = chunk["usage"]["prompt_tokens"]
            }
        }
        if !chunk.has("choices") or len(chunk["choices"]) == 0 {
            return out
        }
        let delta = chunk["choices"][0]["delta"]
        if delta == null {
            return out
        }
        if delta.has("content") and delta["content"] != null {
            let piece = str(delta["content"])
            if piece != "" {
                text = text + piece
                out = out + emit("response.output_text.delta", {
                    "type": "response.output_text.delta",
                    "item_id": item_id,
                    "output_index": 0,
                    "content_index": 0,
                    "delta": piece
                })
            }
        }
        return out
    }

    let finish = fn () {
        var out = ""
        if !started {
            out = out + start()
        }
        out = out + emit("response.output_text.done", {
            "type": "response.output_text.done",
            "item_id": item_id,
            "output_index": 0,
            "content_index": 0,
            "text": text
        })
        out = out + emit("response.content_part.done", {
            "type": "response.content_part.done",
            "item_id": item_id,
            "output_index": 0,
            "content_index": 0,
            "part": { "type": "output_text", "text": text, "annotations": [] }
        })
        out = out + emit("response.output_item.done", {
            "type": "response.output_item.done",
            "output_index": 0,
            "item": {
                "type": "message",
                "id": item_id,
                "status": "completed",
                "role": "assistant",
                "content": [{ "type": "output_text", "text": text, "annotations": [] }]
            }
        })
        out = out + emit("response.completed", {
            "type": "response.completed",
            "response": {
                "id": response_id,
                "object": "response",
                "created_at": int(now()),
                "status": "completed",
                "model": model,
                "output": [
                    {
                        "type": "message",
                        "id": item_id,
                        "status": "completed",
                        "role": "assistant",
                        "content": [{ "type": "output_text", "text": text, "annotations": [] }]
                    }
                ],
                "usage": {
                    "input_tokens": input_tokens,
                    "output_tokens": output_tokens,
                    "total_tokens": input_tokens + output_tokens
                }
            }
        })
        return out
    }

    let usage = fn () {
        return { "input_tokens": input_tokens, "output_tokens": output_tokens }
    }

    return { "feed": feed, "finish": finish, "usage": usage }
}
