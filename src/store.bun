// src/store.bun — the whole database, in one JSON file.
//
// Bun has file I/O but no SQL driver, so the store is a document that lives
// in memory and is written back on every mutation. Writes are serialised by
// a mutex because the server answers each connection on its own thread.
//
// Shape:
//   settings  dict
//   users     list
//   keys      list   (API keys, hashed)
//   models    list
//   usage     list
//   ledger    list
//   sessions  list
//   admins    list

import { CONFIG } from "./config.bun"

let EMPTY = {
    "version": 1,
    "settings": {},
    "users": [],
    "keys": [],
    "models": [],
    "usage": [],
    "ledger": [],
    "sessions": [],
    "admins": []
}

let GUARD = mutex()
var STATE = null
var LOADED = false

fn ensure_dir(path) {
    let parts = path.split("/")
    if len(parts) <= 1 {
        return null
    }
    var current = ""
    var i = 0
    while i < len(parts) - 1 {
        if parts[i] != "" {
            if current == "" {
                current = parts[i]
            } else {
                current = current + "/" + parts[i]
            }
            if !file_exists(current) {
                make_dir(current)
            }
        }
        i = i + 1
    }
    return null
}

fn blank() {
    return {
        "version": 1,
        "settings": {},
        "users": [],
        "keys": [],
        "models": [],
        "usage": [],
        "ledger": [],
        "sessions": [],
        "admins": []
    }
}

fn normalise(doc) {
    let out = blank()
    for key in out.keys() {
        if doc.has(key) {
            out[key] = doc.get(key)
        }
    }
    return out
}

fn load_once() {
    if LOADED {
        return null
    }
    LOADED = true
    let path = CONFIG["data_file"]
    if file_exists(path) {
        try {
            STATE = normalise(json_parse(read_file(path)))
        } catch err {
            print("[store] cannot read " + path + ": " + str(err))
            STATE = blank()
        }
    } else {
        STATE = blank()
    }
    return null
}

export fn store_data() {
    load_once()
    return STATE
}

export fn store_save() {
    load_once()
    let path = CONFIG["data_file"]
    ensure_dir(path)
    write_file(path, json_stringify(STATE))
    return null
}

// Run a mutation under the lock, then write the file.
export fn store_mutate(work) {
    load_once()
    lock(GUARD)
    var result = null
    try {
        result = work(STATE)
        store_save()
    } catch err {
        unlock(GUARD)
        throw str(err)
    }
    unlock(GUARD)
    return result
}

// ---------------------------------------------------------------------------
// Collection helpers
// ---------------------------------------------------------------------------

export fn store_all(collection) {
    let doc = store_data()
    if !doc.has(collection) {
        return []
    }
    return doc[collection]
}

export fn store_find(collection, predicate) {
    for item in store_all(collection) {
        if predicate(item) {
            return item
        }
    }
    return null
}

export fn store_where(collection, predicate) {
    let out = []
    for item in store_all(collection) {
        if predicate(item) {
            out.push(item)
        }
    }
    return out
}

export fn store_by_id(collection, id) {
    return store_find(collection, fn (item) {
        return item["id"] == id
    })
}

export fn store_insert(collection, item) {
    return store_mutate(fn (doc) {
        doc[collection].push(item)
        return item
    })
}

export fn store_remove(collection, id) {
    return store_mutate(fn (doc) {
        let kept = []
        var removed = null
        for item in doc[collection] {
            if item["id"] == id {
                removed = item
            } else {
                kept.push(item)
            }
        }
        doc[collection] = kept
        return removed
    })
}

export fn store_setting(key, fallback) {
    let doc = store_data()
    if doc["settings"].has(key) {
        return doc["settings"].get(key)
    }
    return fallback
}

export fn store_set_setting(key, value) {
    return store_mutate(fn (doc) {
        doc["settings"][key] = value
        return value
    })
}

// Trim the usage log to the newest `keep` rows. Called on write so the file
// does not grow without bound on a busy gateway.
export fn store_trim_usage(keep) {
    return store_mutate(fn (doc) {
        let rows = doc["usage"]
        if len(rows) > keep {
            let start = len(rows) - keep
            doc["usage"] = rows.slice(start, len(rows))
        }
        return null
    })
}
