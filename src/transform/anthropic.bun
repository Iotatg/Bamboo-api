// src/transform/anthropic.bun — Anthropic Messages on the outside, OpenAI
// chat completions on the inside.
//
// The upstream speaks one protocol. This module translates the request in
// and the answer out, including the SSE events, so a Claude SDK pointed at
// Bamboo gets what it expects.

import { crypto_hex_of, crypto_random_hex, crypto_uuid, crypto_new_api_key, crypto_hash_key, crypto_key_prefix, crypto_hash_password, crypto_verify_password, crypto_hex_to_bytes, crypto_same_secret, crypto_token } from "../crypto.bun"

fn text_of(content) {
    if content == null {
        return ""
    }
    if type_of(content) == "string" {
        return content
    }
    if type_of(content) == "list" {
        var out = ""
        for part in content {
            if type_of(part) == "dict" {
                if part.has("text") {
                    out = out + str(part["text"])
                } else if part.has("content") {
                    out = out + text_of(part["content"])
                }
            } else {
                out = out + str(part)
            }
        }
        return out
    }
    if type_of(content) == "dict" and content.has("text") {
        return str(content["text"])
    }
    return ""
}

fn image_part(block) {
    if !block.has("source") {
        return null
    }
    let source = block["source"]
    if type_of(source) != "dict" {
        return null
    }
    if source.has("type") and source["type"] == "base64" {
        var media = "image/png"
        if source.has("media_type") {
            media = str(source["media_type"])
        }
        return {
            "type": "image_url",
            "image_url": { "url": "data:" + media + ";base64," + str(source["data"]) }
        }
    }
    if source.has("type") and source["type"] == "url" {
        return { "type": "image_url", "image_url": { "url": str(source["url"]) } }
    }
    return null
}

fn content_to_openai(content) {
    if type_of(content) == "string" {
        return content
    }
    let parts = []
    if type_of(content) != "list" {
        return ""
    }
    for block in content {
        if type_of(block) != "dict" {
            parts.push({ "type": "text", "text": str(block) })
            continue
        }
        var kind = ""
        if block.has("type") {
            kind = str(block["type"])
        }
        if kind == "text" {
            parts.push({ "type": "text", "text": str(block["text"]) })
        } else if kind == "image" {
            let image = image_part(block)
            if image != null {
                parts.push(image)
            }
        } else if kind == "tool_result" {
            parts.push({ "type": "text", "text": text_of(block["content"]) })
        } else if kind == "document" {
            parts.push({ "type": "text", "text": text_of(block["content"]) })
        }
    }
    if len(parts) == 0 {
        return ""
    }
    var only_text = true
    for part in parts {
        if part["type"] != "text" {
            only_text = false
        }
    }
    if only_text {
        var out = ""
        for part in parts {
            out = out + part["text"]
        }
        return out
    }
    return parts
}

// Anthropic messages -> OpenAI messages. Tool results become `tool` turns,
// tool calls become `assistant.tool_calls`.
export fn anthropic_messages_to_chat(messages) {
    let out = []
    for message in messages {
        var role = "user"
        if message.has("role") {
            role = str(message["role"])
        }
        var content = null
        if message.has("content") {
            content = message["content"]
        }
        if role == "assistant" {
            let calls = []
            var text = ""
            if type_of(content) == "list" {
                for block in content {
                    if type_of(block) == "dict" and block.has("type") {
                        if block["type"] == "tool_use" {
                            calls.push({
                                "id": str(block["id"]),
                                "type": "function",
                                "function": {
                                    "name": str(block["name"]),
                                    "arguments": json_stringify(block["input"])
                                }
                            })
                        } else if block["type"] == "text" {
                            text = text + str(block["text"])
                        }
                    }
                }
            } else {
                text = text_of(content)
            }
            let turn = { "role": "assistant", "content": text }
            if len(calls) > 0 {
                turn["tool_calls"] = calls
            }
            out.push(turn)
        } else if role == "user" {
            if type_of(content) == "list" {
                let tool_results = []
                let normal = []
                for block in content {
                    if type_of(block) == "dict" and block.has("type") and block["type"] == "tool_result" {
                        tool_results.push(block)
                    } else {
                        normal.push(block)
                    }
                }
                if len(tool_results) > 0 {
                    for block in tool_results {
                        out.push({
                            "role": "tool",
                            "tool_call_id": str(block["tool_use_id"]),
                            "content": text_of(block["content"])
                        })
                    }
                    if len(normal) > 0 {
                        out.push({ "role": "user", "content": content_to_openai(normal) })
                    }
                } else {
                    out.push({ "role": "user", "content": content_to_openai(content) })
                }
            } else {
                out.push({ "role": "user", "content": text_of(content) })
            }
        } else {
            out.push({ "role": role, "content": content_to_openai(content) })
        }
    }
    return out
}

export fn anthropic_tools_to_openai(tools) {
    if tools == null {
        return null
    }
    let out = []
    for tool in tools {
        if type_of(tool) != "dict" {
            continue
        }
        var schema = {}
        if tool.has("input_schema") {
            schema = tool["input_schema"]
        }
        out.push({
            "type": "function",
            "function": {
                "name": str(tool["name"]),
                "description": str(tool["description"]),
                "parameters": schema
            }
        })
    }
    if len(out) == 0 {
        return null
    }
    return out
}

export fn anthropic_tool_choice_to_openai(choice) {
    if choice == null {
        return null
    }
    if type_of(choice) == "string" {
        if choice == "any" {
            return "required"
        }
        if choice == "auto" {
            return "auto"
        }
        return null
    }
    if type_of(choice) == "dict" {
        if choice.has("type") and choice["type"] == "tool" {
            return { "type": "function", "function": { "name": str(choice["name"]) } }
        }
    }
    return null
}

// Build the OpenAI body for an Anthropic request.
export fn anthropic_to_chat_request(body, upstream_model) {
    let messages = []
    if body.has("system") {
        let system_text = text_of(body["system"])
        if system_text != "" {
            messages.push({ "role": "system", "content": system_text })
        }
    }
    if body.has("messages") {
        for message in anthropic_messages_to_chat(body["messages"]) {
            messages.push(message)
        }
    }
    let payload = {
        "model": upstream_model,
        "messages": messages,
        "stream": false
    }
    if body.has("stream") {
        payload["stream"] = body["stream"]
    }
    if body.has("max_tokens") {
        payload["max_tokens"] = body["max_tokens"]
    }
    if body.has("temperature") {
        payload["temperature"] = body["temperature"]
    }
    if body.has("top_p") {
        payload["top_p"] = body["top_p"]
    }
    if body.has("stop_sequences") {
        payload["stop"] = body["stop_sequences"]
    }
    if body.has("tools") {
        let tools = anthropic_tools_to_openai(body["tools"])
        if tools != null {
            payload["tools"] = tools
            let choice = anthropic_tool_choice_to_openai(body["tool_choice"])
            if choice != null {
                payload["tool_choice"] = choice
            }
        }
    }
    if payload["stream"] == true {
        payload["stream_options"] = { "include_usage": true }
    }
    return payload
}

// ---------------------------------------------------------------------------
// The answer
// ---------------------------------------------------------------------------

fn finish_reason(reason) {
    if reason == "length" {
        return "max_tokens"
    }
    if reason == "tool_calls" {
        return "tool_use"
    }
    if reason == "stop" {
        return "end_turn"
    }
    if reason == null {
        return "end_turn"
    }
    return "end_turn"
}

export fn anthropic_from_chat_response(data, model) {
    let content = []
    var choice = { "message": { "content": "" } }
    if data.has("choices") and len(data["choices"]) > 0 {
        choice = data["choices"][0]
    }
    var message = choice["message"]
    if message == null {
        message = {}
    }
    if message.has("content") and message["content"] != null {
        let text = message["content"]
        if type_of(text) == "string" and text != "" {
            content.push({ "type": "text", "text": text })
        }
    }
    var stop_reason = "end_turn"
    if choice.has("finish_reason") {
        stop_reason = finish_reason(choice["finish_reason"])
    }
    if message.has("tool_calls") {
        for call in message["tool_calls"] {
            var arguments = {}
            if call["function"].has("arguments") {
                let raw = call["function"]["arguments"]
                if type_of(raw) == "string" and raw != "" {
                    try {
                        arguments = json_parse(raw)
                    } catch err {
                        arguments = { "raw": raw }
                    }
                }
            }
            content.push({
                "type": "tool_use",
                "id": str(call["id"]),
                "name": str(call["function"]["name"]),
                "input": arguments
            })
        }
        stop_reason = "tool_use"
    }
    var input_tokens = 0
    var output_tokens = 0
    if data.has("usage") {
        let usage = data["usage"]
        if usage.has("prompt_tokens") {
            input_tokens = usage["prompt_tokens"]
        }
        if usage.has("completion_tokens") {
            output_tokens = usage["completion_tokens"]
        }
    }
    return {
        "id": "msg_" + crypto_random_hex(12),
        "type": "message",
        "role": "assistant",
        "model": model,
        "content": content,
        "stop_reason": stop_reason,
        "stop_sequence": null,
        "usage": { "input_tokens": input_tokens, "output_tokens": output_tokens }
    }
}

// ---------------------------------------------------------------------------
// The stream
// ---------------------------------------------------------------------------

fn event(name, payload) {
    return "event: " + name + "\n" + "data: " + json_stringify(payload) + "\n\n"
}

// A mapper holds the little state the Anthropic stream needs: whether the
// message started, which block is open, and how many tokens the upstream
// reported. `feed` takes one parsed OpenAI chunk and returns the text to
// write to the client.
export fn anthropic_stream_mapper(model, prompt_tokens) {
    var started = false
    var block_open = false
    var block_index = 0
    var tool_index = -1
    var stop_reason = "end_turn"
    var output_tokens = 0
    var input_tokens = prompt_tokens

    let start = fn () {
        started = true
        return event("message_start", {
            "type": "message_start",
            "message": {
                "id": "msg_" + crypto_random_hex(12),
                "type": "message",
                "role": "assistant",
                "model": model,
                "content": [],
                "stop_reason": null,
                "stop_sequence": null,
                "usage": { "input_tokens": input_tokens, "output_tokens": 0 }
            }
        })
    }

    let open_text = fn () {
        if block_open {
            return ""
        }
        block_open = true
        return event("content_block_start", {
            "type": "content_block_start",
            "index": block_index,
            "content_block": { "type": "text", "text": "" }
        })
    }

    let close_block = fn () {
        if !block_open {
            return ""
        }
        block_open = false
        let out = event("content_block_stop", { "type": "content_block_stop", "index": block_index })
        block_index = block_index + 1
        return out
    }

    let feed = fn (chunk) {
        var out = ""
        if !started {
            out = out + start()
        }
        if chunk.has("usage") and chunk["usage"] != null {
            let usage = chunk["usage"]
            if usage.has("completion_tokens") {
                output_tokens = usage["completion_tokens"]
            }
            if usage.has("prompt_tokens") and usage["prompt_tokens"] > 0 {
                input_tokens = usage["prompt_tokens"]
            }
        }
        if !chunk.has("choices") or len(chunk["choices"]) == 0 {
            return out
        }
        let choice = chunk["choices"][0]
        if choice.has("finish_reason") and choice["finish_reason"] != null {
            stop_reason = finish_reason(choice["finish_reason"])
        }
        var delta = {}
        if choice.has("delta") and choice["delta"] != null {
            delta = choice["delta"]
        }
        if delta.has("content") and delta["content"] != null {
            let text = str(delta["content"])
            if text != "" {
                out = out + open_text()
                out = out + event("content_block_delta", {
                    "type": "content_block_delta",
                    "index": block_index,
                    "delta": { "type": "text_delta", "text": text }
                })
            }
        }
        if delta.has("tool_calls") {
            for call in delta["tool_calls"] {
                var call_index = 0
                if call.has("index") {
                    call_index = call["index"]
                }
                if call_index != tool_index {
                    out = out + close_block()
                    tool_index = call_index
                    var name = ""
                    var call_id = "toolu_" + crypto_random_hex(8)
                    if call.has("function") and call["function"].has("name") {
                        name = str(call["function"]["name"])
                    }
                    if call.has("id") and call["id"] != null {
                        call_id = str(call["id"])
                    }
                    block_open = true
                    out = out + event("content_block_start", {
                        "type": "content_block_start",
                        "index": block_index,
                        "content_block": {
                            "type": "tool_use",
                            "id": call_id,
                            "name": name,
                            "input": {}
                        }
                    })
                }
                if call.has("function") and call["function"].has("arguments") {
                    let piece = str(call["function"]["arguments"])
                    if piece != "" {
                        out = out + event("content_block_delta", {
                            "type": "content_block_delta",
                            "index": block_index,
                            "delta": { "type": "input_json_delta", "partial_json": piece }
                        })
                    }
                }
            }
        }
        return out
    }

    let finish = fn () {
        var out = close_block()
        if !started {
            out = out + start()
        }
        out = out + event("message_delta", {
            "type": "message_delta",
            "delta": { "stop_reason": stop_reason, "stop_sequence": null },
            "usage": { "output_tokens": output_tokens }
        })
        out = out + event("message_stop", { "type": "message_stop" })
        return out
    }

    let usage = fn () {
        return { "input_tokens": input_tokens, "output_tokens": output_tokens }
    }

    return { "feed": feed, "finish": finish, "usage": usage }
}
